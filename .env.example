# Local-only configuration. Copy to .env; never commit .env.

# LiveKit provides realtime voice/video transport. Ollama remains Jarvis' local reasoning LLM.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional local reasoning configuration.
NEXORA_OLLAMA_HOST=http://127.0.0.1:11434
NEXORA_OLLAMA_MODEL=llama3.1:8b
